# Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# Security Secrets (Must be changed in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123!
JWT_SECRET=super_secret_jwt_signing_key_replace_me_random_long_string_12345
ENCRYPTION_MASTER_KEY=32_char_master_secret_key_1234567890123456789012

# Database Path
DB_PATH=./data/license.db

# Security Settings
MIN_EXTENSION_VERSION=0.1.0
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
